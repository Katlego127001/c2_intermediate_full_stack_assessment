# --- App ---
APP_NAME=JobTracker
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost"]

# --- Security ---
SECRET_KEY=change-me-please-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# --- Database ---
POSTGRES_USER=postgres_tracking_user
POSTGRES_PASSWORD=JobTracking3213
POSTGRES_DB=job_tracking_db
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
DATABASE_URL=postgresql+asyncpg://postgres_tracking_user:JobTracking3213@localhost:5432/job_tracking_db
SYNC_DATABASE_URL=postgresql+psycopg2://postgres_tracking_user:JobTracking3213@localhost:5432/job_tracking_db


# --- Redis / Celery ---
# REDIS_URL=redis://redis:6379/0
# CELERY_BROKER_URL=redis://redis:6379/1
# CELERY_RESULT_BACKEND=redis://redis:6379/2
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2


# --- Bootstrap admin (created by seed) ---
FIRST_ADMIN_EMAIL=admin@jobtracker.com
FIRST_ADMIN_PASSWORD=Admin123!
FIRST_ADMIN_FIRST_NAME=Site
FIRST_ADMIN_LAST_NAME=Admin

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=120
